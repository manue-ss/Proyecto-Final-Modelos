# ==========================================
# Java / Maven .gitignore
# ==========================================

# Archivos compilados de Java
*.class

# Archivos de empaquetado
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Directorios de compilación de Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Logs
*.log

# ==========================================
# Entornos de Desarrollo (IDEs)
# ==========================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
out/

# Eclipse
.classpath
.project
.settings/
.apt_generated/
.factorypath
bin/

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# VS Code
.vscode/

# ==========================================
# Sistema Operativo
# ==========================================
.DS_Store
Thumbs.db